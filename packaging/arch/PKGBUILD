# Maintainer: refighdev
pkgname=muse-code-gui-bin
_name=MuseCodeGUI
pkgver=0.1.1
pkgrel=1
pkgdesc='Desktop GUI for the Muse Code CLI, with right-to-left (Persian/Arabic/Hebrew) text support (AppImage release)'
arch=('x86_64')
url='https://github.com/refighdev/muse-code-gui-rtl-support'
license=('MIT')
depends=('fuse2' 'zlib' 'hicolor-icon-theme')
optdepends=('muse-code-bin: the Muse Code CLI this app drives')
provides=('muse-code-gui')
conflicts=('muse-code-gui')
options=('!strip' '!debug')
_appimage="${_name}_${pkgver}_amd64.AppImage"
source=("${_appimage}::${url}/releases/download/v${pkgver}/${_appimage}")
noextract=("${_appimage}")
sha256sums=('3876df19a59e6ab8e1b3a2024bd51d54810f41d95ab81b266e10d3c6500739f8')

build() {
  chmod +x "${_appimage}"
  # pull the icon out of the AppImage (best effort)
  ./"${_appimage}" --appimage-extract '*.png' >/dev/null 2>&1 || true
}

package() {
  install -Dm755 "${_appimage}" "${pkgdir}/opt/${pkgname}/${_name}.AppImage"

  install -d "${pkgdir}/usr/bin"
  cat > "${pkgdir}/usr/bin/muse-code-gui" <<'WRAP'
#!/bin/sh
exec /opt/muse-code-gui-bin/MuseCodeGUI.AppImage "$@"
WRAP
  chmod 755 "${pkgdir}/usr/bin/muse-code-gui"

  local icon
  icon=$(find squashfs-root -maxdepth 1 -name '*.png' 2>/dev/null | head -n1)
  [ -n "$icon" ] && install -Dm644 "$icon" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/muse-code-gui.png"

  install -Dm644 /dev/stdin "${pkgdir}/usr/share/applications/muse-code-gui.desktop" <<'DESK'
[Desktop Entry]
Type=Application
Name=Muse Code GUI
Comment=Desktop GUI for Muse Code, with RTL support
Exec=muse-code-gui
Icon=muse-code-gui
Categories=Development;
Terminal=false
DESK
}
